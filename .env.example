# Copier ce fichier en ".env.local" pour changer la configuration en local.

# true  = le front utilise l'API simulée (src/api/mock), aucun back nécessaire
# false = le front appelle le vrai back FastAPI via le proxy Vite (/api -> VITE_API_TARGET)
VITE_USE_MOCK=true

# Adresse du back FastAPI (utilisée seulement par le proxy de développement de Vite)
VITE_API_TARGET=http://localhost:8000
